# Settings for the career-ops-web service. setup.sh installs this as
# /etc/careerreboot/web.env (root-only, 0600); edit it there, then
# `sudo systemctl restart career-ops-web`. API keys do NOT go here: the
# pipeline reads them from agents/career-ops/.env and agents/hiring-radar/.env.

# Extra Host names the dashboard may answer on, comma-separated. Leave empty
# for SSH-tunnel access. With `tailscale serve`, set your machine's tailnet
# name, e.g. career-reboot.your-tailnet.ts.net
CAREER_OPS_WEB_ALLOWED_HOSTS=
