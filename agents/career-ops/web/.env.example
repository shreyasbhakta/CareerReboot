# Copy to .env.local (gitignored) and fill in.

# See src/lib/origin-guard.mjs for these two:
# CAREER_OPS_WEB_ALLOWED_HOSTS=
# CAREER_OPS_ALLOWED_ORIGINS=

# Background video on every page (https URL or a path under public/).
# Leave unset for the built-in default; each browser can override it in Settings → Appearance.
# NEXT_PUBLIC_BACKGROUND_VIDEO_URL=https://cdn.example.com/your-background.mp4
