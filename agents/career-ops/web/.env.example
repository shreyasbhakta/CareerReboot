# Copy to .env.local (gitignored) and fill in.

# Single-password gate for the whole app (see src/proxy.ts + src/lib/session.mjs).
# Both must be set for the gate to activate — unset (either), it fails OPEN
# (no login required), which is fine for local dev but must be set before
# this is ever reachable beyond your own machine (Tailscale, an exposed VM).
CAREER_OPS_WEB_PASSWORD=
CAREER_OPS_WEB_SESSION_SECRET=

# Set to 1 only if this is served behind real TLS (not the SSH-tunnel/localhost
# setup this project defaults to) — makes the session cookie `Secure`.
# CAREER_OPS_WEB_COOKIE_SECURE=1

# See src/lib/origin-guard.mjs for these two (pre-existing, unrelated to the
# password gate above):
# CAREER_OPS_WEB_ALLOWED_HOSTS=
# CAREER_OPS_ALLOWED_ORIGINS=
