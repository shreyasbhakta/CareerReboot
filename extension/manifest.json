{
  "manifest_version": 3,
  "name": "CareerReboot Resume Tailor",
  "version": "1.1.0",
  "description": "Send the job description on this page to your local CareerReboot and download a tailored one-page resume.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Tailor resume",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
