# Secrets — never commit
.env
*.env
!*.env.example

# Local AI-tool state/config — machine-specific, never shared. .claude/ holds
# session worktrees and lock files; .continue/ can hold model config that
# resolves secrets from its own .env (see Continue's secrets docs) — neither
# belongs in the repo regardless.
/.claude/*
!/.claude/settings.json
!/.claude/skills/
.claude/
.continue/

# Dependencies
node_modules/

# OS cruft
.DS_Store

# Hiring Radar — local config, workflow data dir, and any LinkedIn export
agents/hiring-radar/config.yml
agents/hiring-radar/.env
.hiring-radar-data/
Connections.csv
**/Connections.csv
!agents/hiring-radar/tests/fixtures/Connections.csv

# macOS/cloud-sync conflict copies ("file 2.ext") — never commit
* 2
* 2.*
* 2/

# Graphify: commit only the report; the graph itself is regenerated with `npm run graph`
**/graphify-out/*
!**/graphify-out/GRAPH_REPORT.md

# Job research — your scoring profile (copy candidate-profile.example.yml)
job-finding-research/candidate-profile.yml

# Snapshots the dashboard takes before overwriting a config file
*.bak-*

# `npm run reset` moves local data here instead of deleting it
.careerreboot-backups/
